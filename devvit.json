{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pack-of-the-day",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator",
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Pack of the Day: post today's pack",
        "description": "Posts today's puzzle if it is not up yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Pack of the Day: post a pack for a date",
        "description": "Posts the puzzle of a chosen day",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-date"
      }
    ]
  },
  "forms": {
    "postDateForm": "/internal/form/post-date"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-pack": {
        "endpoint": "/internal/cron/daily-pack",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "pack_of_the_day_dev"
  }
}